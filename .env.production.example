# Azure HayMaker Orchestrator - Production Environment Variables
# Copy to .env and fill in real values

# === AZURE AUTHENTICATION ===
AZURE_TENANT_ID=<your-tenant-id>
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_CLIENT_ID=<your-client-id>

# === AZURE RESOURCES ===
KEY_VAULT_URL=<your-keyvault-url>
SERVICE_BUS_NAMESPACE=<your-servicebus-namespace>
SERVICE_BUS_TOPIC=agent-logs
STORAGE_ACCOUNT_NAME=<your-storage-account-name>
TABLE_STORAGE_ACCOUNT_NAME=<your-table-storage-account-name>
CONTAINER_REGISTRY=<your-container-registry>
CONTAINER_IMAGE=azure-haymaker-agent:latest
LOG_ANALYTICS_WORKSPACE_ID=<your-log-analytics-workspace-id>
RESOURCE_GROUP_NAME=<your-resource-group>

# === CONFIGURATION ===
SIMULATION_SIZE=small
COSMOSDB_ENDPOINT=<your-cosmosdb-endpoint>
COSMOSDB_DATABASE=haymaker

# === SECRETS (REQUIRED) ===
# Get these from Azure Key Vault or use real values
MAIN_SP_CLIENT_SECRET=<your-service-principal-client-secret>
ANTHROPIC_API_KEY=<your-anthropic-api-key>
LOG_ANALYTICS_WORKSPACE_KEY=<your-log-analytics-workspace-key>

# === APP SERVICE SPECIFIC ===
WEBSITES_PORT=80

# Azure HayMaker Orchestrator Environment Variables
# Copy this to .env and fill in your values

# Azure Configuration (Required)
AZURE_TENANT_ID=your-tenant-id
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_CLIENT_ID=your-client-id
KEY_VAULT_URL=https://your-keyvault.vault.azure.net/

# Service Bus (Required)
SERVICE_BUS_NAMESPACE=your-servicebus-namespace

# Container Configuration (Required)
CONTAINER_REGISTRY=yourregistry.azurecr.io
CONTAINER_IMAGE=azure-haymaker-agent:latest

# Simulation Configuration (Required)
SIMULATION_SIZE=small  # Options: small, medium, large

# Storage Configuration (Required)
STORAGE_ACCOUNT_NAME=yourstorageaccount
TABLE_STORAGE_ACCOUNT_NAME=yourtablestorageaccount

# Log Analytics (Required)
LOG_ANALYTICS_WORKSPACE_ID=your-workspace-id

# Optional Configuration
RESOURCE_GROUP_NAME=azure-haymaker-rg
SERVICE_BUS_TOPIC=agent-logs

# Cosmos DB (Optional)
COSMOSDB_ENDPOINT=
COSMOSDB_DATABASE=haymaker

# VNet Integration (Optional)
VNET_INTEGRATION_ENABLED=false
VNET_RESOURCE_GROUP=
VNET_NAME=
SUBNET_NAME=

# Key Vault Secrets (retrieved automatically - do NOT set here)
# - main-sp-client-secret
# - anthropic-api-key
# - log-analytics-workspace-key

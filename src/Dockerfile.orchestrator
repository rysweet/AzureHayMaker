FROM python:3.11-slim

# Install system dependencies including Azure CLI
RUN apt-get update && apt-get install -y \
    curl \
    ca-certificates \
    apt-transport-https \
    lsb-release \
    gnupg \
    && curl -sL https://aka.ms/InstallAzureCLIDeb | bash \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install FastAPI and APScheduler (if not in requirements.txt)
RUN pip install --no-cache-dir fastapi uvicorn apscheduler

# Copy application code
COPY . .

# Copy scenario files to /docs/scenarios (scenario_selector.py looks at project root)
COPY docs_scenarios /docs/scenarios

# Expose port 80
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:80/ || exit 1

# Run the orchestrator
CMD ["python", "orchestrator_server.py"]

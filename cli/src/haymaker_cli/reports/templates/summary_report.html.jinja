{% extends "base.html.jinja" %}

{% block title %}{{ metadata.title }}{% endblock %}

{% block header_info %}
<div class="badge bg-light text-dark p-2">
    <strong>{{ metadata.total_records }}</strong> Total Executions
</div>
{% endblock %}

{% block content %}
<!-- KPI Cards -->
<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="card kpi-card h-100">
            <div class="card-body">
                <div class="kpi-label">Total Executions</div>
                <div class="kpi-value">{{ kpis.total_executions }}</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card kpi-card h-100">
            <div class="card-body">
                <div class="kpi-label">Success Rate</div>
                <div class="kpi-value">{{ "%.1f"|format(kpis.success_rate) }}%</div>
                <small class="text-muted">
                    {{ kpis.successful_executions }} completed
                </small>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card kpi-card h-100">
            <div class="card-body">
                <div class="kpi-label">Avg Duration</div>
                <div class="kpi-value">{{ "%.1f"|format(kpis.avg_duration_seconds) }}s</div>
                <small class="text-muted">
                    Min: {{ "%.1f"|format(kpis.min_duration_seconds) }}s,
                    Max: {{ "%.1f"|format(kpis.max_duration_seconds) }}s
                </small>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card kpi-card h-100">
            <div class="card-body">
                <div class="kpi-label">Total Agents</div>
                <div class="kpi-value">{{ kpis.total_agents }}</div>
                <small class="text-muted">
                    {{ "%.1f"|format(kpis.agent_success_rate) }}% success rate
                </small>
            </div>
        </div>
    </div>
</div>

<!-- Status Breakdown -->
<div class="row mb-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Execution Status Breakdown</h5>
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-md-3">
                        <div class="p-3">
                            <h3 class="text-success">{{ kpis.successful_executions }}</h3>
                            <small class="text-muted">Completed</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-3">
                            <h3 class="text-danger">{{ kpis.failed_executions }}</h3>
                            <small class="text-muted">Failed</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-3">
                            <h3 class="text-info">{{ kpis.running_executions }}</h3>
                            <small class="text-muted">Running</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-3">
                            <h3 class="text-secondary">{{ kpis.cancelled_executions }}</h3>
                            <small class="text-muted">Cancelled</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts -->
{% if charts %}
<div class="row mb-4">
    {% if charts.timeline %}
    <div class="col-md-8 mb-3">
        <div class="chart-container">
            <h5 class="mb-3">Execution Timeline</h5>
            <div id="timelineChart"></div>
        </div>
    </div>
    {% endif %}

    {% if charts.status_distribution %}
    <div class="col-md-4 mb-3">
        <div class="chart-container">
            <h5 class="mb-3">Status Distribution</h5>
            <div id="statusChart"></div>
        </div>
    </div>
    {% endif %}
</div>
{% endif %}

<!-- Top Scenarios -->
{% if top_scenarios %}
<div class="row mb-4">
    <div class="col-md-12">
        <div class="table-container">
            <h5 class="mb-3">Top Scenarios</h5>
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Scenario</th>
                        <th class="text-end">Executions</th>
                        <th class="text-end">Success Rate</th>
                    </tr>
                </thead>
                <tbody>
                    {% for scenario in top_scenarios %}
                    <tr>
                        <td>{{ scenario.scenario }}</td>
                        <td class="text-end">{{ scenario.count }}</td>
                        <td class="text-end">{{ "%.1f"|format(scenario.success_rate) }}%</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endif %}

<!-- Top Regions -->
{% if top_regions %}
<div class="row mb-4">
    <div class="col-md-6 mb-3">
        <div class="table-container">
            <h5 class="mb-3">Top Regions</h5>
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Region</th>
                        <th class="text-end">Agent Count</th>
                    </tr>
                </thead>
                <tbody>
                    {% for region in top_regions %}
                    <tr>
                        <td>{{ region.region }}</td>
                        <td class="text-end">{{ region.count }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% if error_distribution %}
    <div class="col-md-6 mb-3">
        <div class="table-container">
            <h5 class="mb-3">Top Errors</h5>
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Error Message</th>
                        <th class="text-end">Count</th>
                    </tr>
                </thead>
                <tbody>
                    {% for error in error_distribution %}
                    <tr>
                        <td class="text-truncate" style="max-width: 300px;">
                            {{ error.error }}
                        </td>
                        <td class="text-end">{{ error.count }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% endif %}
</div>
{% endif %}

<!-- No Data Message -->
{% if kpis.total_executions == 0 %}
<div class="alert alert-info" role="alert">
    <h4 class="alert-heading">No Data Available</h4>
    <p>There are no executions matching the selected filters. Try adjusting your filter criteria or check back later.</p>
</div>
{% endif %}
{% endblock %}

{% block scripts %}
<script>
    {% if charts and charts.timeline %}
    // Timeline Chart
    var timelineData = [{
        x: {{ charts.timeline.x | tojson }},
        y: {{ charts.timeline.y | tojson }},
        type: 'scatter',
        mode: 'lines+markers',
        marker: {color: '#667eea'},
        line: {color: '#667eea', width: 2}
    }];
    var timelineLayout = {
        title: '',
        xaxis: {title: 'Date'},
        yaxis: {title: 'Executions'},
        margin: {l: 50, r: 30, t: 30, b: 50},
        height: 300
    };
    Plotly.newPlot('timelineChart', timelineData, timelineLayout, {responsive: true});
    {% endif %}

    {% if charts and charts.status_distribution %}
    // Status Distribution Chart
    var statusData = [{
        labels: {{ charts.status_distribution.labels | tojson }},
        values: {{ charts.status_distribution.values | tojson }},
        type: 'pie',
        marker: {
            colors: ['#28a745', '#dc3545', '#17a2b8', '#6c757d']
        }
    }];
    var statusLayout = {
        title: '',
        margin: {l: 20, r: 20, t: 30, b: 20},
        height: 300
    };
    Plotly.newPlot('statusChart', statusData, statusLayout, {responsive: true});
    {% endif %}
</script>
{% endblock %}

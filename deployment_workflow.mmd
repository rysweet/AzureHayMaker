    style S2 fill:#50E6FF,stroke:#0078D4,stroke-width:2px
    style S3 fill:#50E6FF,stroke:#0078D4,stroke-width:2px
    style P1 fill:#7FBA00,stroke:#498205,stroke-width:2px
    style P2 fill:#7FBA00,stroke:#498205,stroke-width:2px
    style P3 fill:#7FBA00,stroke:#498205,stroke-width:2px
    style E1 fill:#0078D4,stroke:#004578,stroke-width:2px,color:#fff
    style E2 fill:#0078D4,stroke:#004578,stroke-width:2px,color:#fff
    style E3 fill:#0078D4,stroke:#004578,stroke-width:2px,color:#fff
    style E4 fill:#0078D4,stroke:#004578,stroke-width:2px,color:#fff
    style C1 fill:#E81123,stroke:#A80000,stroke-width:2px,color:#fff
    style C2 fill:#E81123,stroke:#A80000,stroke-width:2px,color:#fff
    style C3 fill:#E81123,stroke:#A80000,stroke-width:2px,color:#fff

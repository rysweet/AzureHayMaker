graph LR
    subgraph "Phase 1: Setup"
        S1[Create App<br/>Registration]
        S2[Configure<br/>Permissions]
        S3[Create Security<br/>Group]
        S1 --> S2 --> S3
    end

    subgraph "Phase 2: Provision"
        P1[Create Entra<br/>Users]
        P2[Assign E5<br/>Licenses]
        P3[Register in<br/>WorkerRegistry]
        P1 --> P2 --> P3
    end

    subgraph "Phase 3: Execute"
        E1[Initialize<br/>Workers]
        E2[Generate M365<br/>Activities]
        E3[Send Emails]
        E4[Create Events]
        E1 --> E2
        E2 --> E3
        E2 --> E4
    end

    subgraph "Phase 4: Cleanup"
        C1[Stop<br/>Workers]
        C2[Delete<br/>Users]
        C3[Remove<br/>Groups]
        C1 --> C2 --> C3
    end

    S3 --> P1
    P3 --> E1
    E4 --> C1
    E3 --> C1

